{
  "poller_type": "workday",
  "url" : "{YOUR_URL_HERE}",
  "credentials": {
    "location" : "{YOUR_PATH_HERE}/creds/workday"
  },
  "authentication" : {
    "type" : "Basic",
    "auth_criteria": {
      "login" : "str",
      "password": "str"
