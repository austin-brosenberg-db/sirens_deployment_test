# Databricks notebook source
# DBTITLE 1,Set working directory to Sirens home
import os

sirens_home = spark.conf.get("sirens.home", None)

if sirens_home is not None:
  os.chdir(sirens_home)

# COMMAND ----------
import dlt
from databricks.sirens.detection import *
from databricks.sirens import config_reader
from databricks.sirens.utils.clustering_utils import ClusteringUtils
import yaml
from pyspark.sql.functions import expr, collect_list, lit, struct, col

# COMMAND ----------

source = spark.conf.get('source', '{{ source }}')
sourcetype = spark.conf.get('sourcetype', '{{ sourcetype }}')
env = spark.conf.get('env', '')
pipeline_yaml = '{{ pipeline_name }}'

# COMMAND ----------

detectionObj = config_reader.Detection(source, sourcetype, env)
clustering_config = detectionObj._load_pipeline_yaml(pipeline_yaml)

# COMMAND ----------

spark_conf = {}
streamType = clustering_config.get('streamType', 'streaming')
if streamType != 'streaming':
  spark_conf["pipelines.trigger.interval"] = clustering_config['interval']

if clustering_config.get("dlt_read", False) is True:
  read_method = dlt.readStream if clustering_config.get("streamType") == "streaming" else dlt.read
else:
  read_method = spark.readStream.table if clustering_config.get("streamType") == "streaming" else spark.read.table

input_table = clustering_config['input_table']
if clustering_config.get('dlt_read') is True and '.' in input_table:
  input_table = input_table.split('.')[1]

pipeline_name = clustering_config['name']

# COMMAND ----------

@dlt.table(name=pipeline_name, spark_conf=spark_conf)
def clustering_table():
  alerts = (
    read_method(input_table)
    .filter(clustering_config['filter'])
  )

  return ClusteringUtils.cluster_alerts(alerts, clustering_config['grouping_keys'], clustering_config['schema_fields'])
